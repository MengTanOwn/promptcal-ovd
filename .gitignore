# feature shards and derived data: tens of GB, never in git
/features/
/data/
*.npz
*.npy

# experiment logs; the JSON results are tracked on purpose
results/*.txt
results/log_*.txt
results/_smoke_*.json
results/_partial_*.json
results/_dry_*.json
results/_test_*.json
results/_check_*.json

# The manuscript source is not distributed with the code.  `promptcal macros` and
# `promptcal figures` write nums.tex, tables/ and fig/ here on demand, so the directory is
# rebuilt locally and stays out of git.
/paper/
/submission/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# local overrides
.env
